#!/usr/bin/env node
/**
 * QuickCart & Appsolve Chaos Scenario Trigger & Verification CLI
 * Milestone 5: Chaos Testing & Acceptance Verification
 *
 * Usage:
 *   bin/chaos inject <sev1|sev2|sev3> [--quickcart-url=<url>] [--appsolve-url=<url>] [--no-traffic]
 *   bin/chaos reset                  [--quickcart-url=<url>] [--appsolve-url=<url>]
 *   bin/chaos status                 [--quickcart-url=<url>] [--appsolve-url=<url>] [--json]
 *   bin/chaos verify                 [--quickcart-url=<url>] [--appsolve-url=<url>]
 */

const http = require('node:http');
const https = require('node:https');

// ANSI Color Helpers
const colors = {
  reset: '\x1b[0m',
  bold: '\x1b[1m',
  dim: '\x1b[2m',
  red: '\x1b[31m',
  green: '\x1b[32m',
  yellow: '\x1b[33m',
  blue: '\x1b[34m',
  magenta: '\x1b[35m',
  cyan: '\x1b[36m',
  white: '\x1b[37m',
  bgRed: '\x1b[41m',
  bgYellow: '\x1b[43m',
  bgBlue: '\x1b[44m'
};

function parseArgs() {
  const args = process.argv.slice(2);
  const options = {
    command: null,
    scenario: null,
    quickcartUrl: process.env.QUICKCART_URL || 'http://localhost:4000',
    appsolveUrl: process.env.APPSOLVE_URL || 'http://localhost:3001',
    token: process.env.BRIDGE_SECRET_TOKEN || 'quickcart-sre-secret-token',
    target: 'all',
    simulateTraffic: true,
    count: 12000,
    json: false,
    verbose: false,
    help: false
  };

  for (let i = 0; i < args.length; i++) {
    const arg = args[i];

    if (arg === '--help' || arg === '-h') {
      options.help = true;
    } else if (arg === '--json') {
      options.json = true;
    } else if (arg === '--verbose' || arg === '-v') {
      options.verbose = true;
    } else if (arg === '--no-traffic' || arg === '--no-simulate-traffic') {
      options.simulateTraffic = false;
    } else if (arg.startsWith('--quickcart-url=')) {
      options.quickcartUrl = arg.split('=')[1].replace(/\/+$/, '');
    } else if (arg.startsWith('--appsolve-url=')) {
      options.appsolveUrl = arg.split('=')[1].replace(/\/+$/, '');
    } else if (arg.startsWith('--token=')) {
      options.token = arg.split('=')[1];
    } else if (arg.startsWith('--target=')) {
      options.target = arg.split('=')[1];
    } else if (arg.startsWith('--count=')) {
      options.count = parseInt(arg.split('=')[1], 10);
    } else if (!options.command) {
      options.command = arg.toLowerCase();
    } else if (!options.scenario) {
      options.scenario = arg.toLowerCase();
    }
  }

  return options;
}

