// HTTP request helper using native fetch
async function apiRequest(url, method = 'GET', body = null, headers = {}) {
  const reqHeaders = { 'Content-Type': 'application/json', ...headers };
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), 8000);

  const start = Date.now();
  try {
    const fetchOptions = {
      method,
      headers: reqHeaders,
      signal: controller.signal
    };
    if (body !== null && method !== 'GET' && method !== 'HEAD') {
      fetchOptions.body = typeof body === 'string' ? body : JSON.stringify(body);
    }
    const res = await fetch(url, fetchOptions);
    const durationMs = Date.now() - start;
    let data;
    const text = await res.text();
    try {
      data = JSON.parse(text);
    } catch {
      data = text;
    }
    return { ok: res.ok, status: res.status, data, durationMs };
  } catch (err) {
    const durationMs = Date.now() - start;
    return { ok: false, status: 0, error: err.message, durationMs };
  } finally {
    clearTimeout(timeout);
  }
}

// SRE Bridge execution helper
async function execBridgeCommand(quickcartUrl, token, command, params = {}) {
  return await apiRequest(`${quickcartUrl}/api/bridge/v1/exec`, 'POST', { command, params }, {
    Authorization: `Bearer ${token}`
  });
}

// COMMAND: INJECT
async function handleInject(options) {
  const scenario = (options.scenario || '').toLowerCase();
  const aliasMap = {
    'sev1': 'sev1', 'sev-1': 'sev1', 'deadlock': 'sev1', 'db-lock': 'sev1', 'checkout-lock': 'sev1',
    'sev2': 'sev2', 'sev-2': 'sev2', 'coupon-bug': 'sev2', 'coupon': 'sev2', 'cart-bug': 'sev2',
    'sev3': 'sev3', 'sev-3': 'sev3', 'cache-bloat': 'sev3', 'cache': 'sev3', 'bloat': 'sev3',
    'tax': 'tax', 'tax-bug': 'tax', 'kdv': 'tax', 'vergi': 'tax',
    'inventory': 'inventory', 'inventory-bug': 'inventory', 'stock': 'inventory', 'stok': 'inventory'
  };
  const normalized = aliasMap[scenario] || scenario.replace(/^sev-?/, 'sev');

  if (!['sev1', 'sev2', 'sev3', 'tax', 'inventory'].includes(normalized)) {
    console.error(`${colors.red}Error: Invalid scenario '${options.scenario}'. Must be deadlock (sev1), coupon-bug (sev2), cache-bloat (sev3), tax-bug, or inventory-bug.${colors.reset}`);
    console.error(`Usage: bin/chaos inject <deadlock|coupon-bug|cache-bloat|tax-bug|inventory-bug>`);
    process.exit(1);
  }

  console.log(`\n${colors.bold}${colors.magenta}=== APPSOLVE & QUICKCART CHAOS INJECTION RUNNER ===${colors.reset}`);
  console.log(`Target QuickCart: ${colors.cyan}${options.quickcartUrl}${colors.reset}`);
  console.log(`Target Appsolve:  ${colors.cyan}${options.appsolveUrl}${colors.reset}`);
  console.log(`Scenario:         ${colors.bold}${normalized.toUpperCase()}${colors.reset}\n`);

  if (normalized === 'sev1') {
    // ----------------------------------------------------
    // SEV-1: Checkout Database Deadlock Simulation
    // ----------------------------------------------------
    console.log(`${colors.bold}[1/3] Injecting exclusive uncommitted row lock on payment_records...${colors.reset}`);
    const injectRes = await apiRequest(`${options.quickcartUrl}/api/chaos/lock-checkout`, 'POST', { pid: 4821 });
    if (!injectRes.ok) {
      console.error(`${colors.red}✖ Failed to inject checkout lock: ${injectRes.status} ${JSON.stringify(injectRes.data || injectRes.error)}${colors.reset}`);
      process.exit(1);
    }
    console.log(`${colors.green}✔ Lock injected successfully:${colors.reset} ${injectRes.data?.message || 'Lock active'}`);

    if (options.simulateTraffic) {
      console.log(`${colors.bold}[2/3] Simulating checkout transaction traffic to trigger deadlock & telemetry...${colors.reset}`);
      const cartId = `chaos_sev1_probe_${Date.now()}`;
      // Add product 1 to cart
      await apiRequest(`${options.quickcartUrl}/api/cart/items`, 'POST', { cart_id: cartId, product_id: 1, quantity: 1 });
      
      // Attempt checkout -> expects HTTP 504 DB_LOCK_TIMEOUT
      const checkoutRes = await apiRequest(`${options.quickcartUrl}/api/checkout`, 'POST', {
        cart_id: cartId,
        shipping_address: '100 Chaos Way, Suite 404',
        payment_method: 'card'
      });

      if (checkoutRes.status === 504) {
        console.log(`${colors.green}✔ Checkout blocked as expected:${colors.reset} HTTP 504 DB_LOCK_TIMEOUT`);
        console.log(`${colors.green}✔ QuickCart Telemetry Forwarder intercepted error and forwarded signal to Appsolve!${colors.reset}`);
      } else {
        console.log(`${colors.yellow}ℹ Checkout returned status ${checkoutRes.status} (expected 504):${colors.reset}`, checkoutRes.data);
      }
    }

    console.log(`${colors.bold}[3/3] Inspecting SRE Bridge diagnostic output...${colors.reset}`);
    const bridgeRes = await execBridgeCommand(options.quickcartUrl, options.token, 'inspect_db_locks');
    if (bridgeRes.ok) {
      console.log(`  Bridge Diagnostic: ${colors.yellow}${bridgeRes.data?.output || 'Lock holding'}${colors.reset}`);
    }

    console.log(`\n${colors.bold}${colors.green}================================================================${colors.reset}`);
    console.log(`${colors.bold}${colors.green}  ✔ SEV-1 INCIDENT INJECTED & ACTIVE${colors.reset}`);
    console.log(`${colors.bold}  Severity:       ${colors.red}SEV-1 (CRITICAL OUTAGE)${colors.reset}`);
    console.log(`${colors.bold}  Error Code:     ${colors.white}ERR_DB_LOCK_TIMEOUT${colors.reset}`);
    console.log(`${colors.bold}  Guardrail Mode: ${colors.yellow}manual_command_only${colors.reset} (Approval required)`);
    console.log(`${colors.bold}  Remediation:    ${colors.cyan}Appsolve War Room -> Execute 'kill_db_locks'${colors.reset}`);
    console.log(`${colors.bold}  To Reset:       ${colors.cyan}bin/chaos reset${colors.reset}`);
    console.log(`${colors.bold}${colors.green}================================================================${colors.reset}\n`);

  } else if (normalized === 'sev2') {
    // ----------------------------------------------------
    // SEV-2: Cart Coupon Calculation Bug Injection
    // ----------------------------------------------------
    console.log(`${colors.bold}[1/3] Injecting coupon calculation bug (promo_v2 rate config missing)...${colors.reset}`);
    const injectRes = await apiRequest(`${options.quickcartUrl}/api/chaos/inject-coupon-bug`, 'POST', {});
    if (!injectRes.ok) {
      console.error(`${colors.red}✖ Failed to inject coupon bug: ${injectRes.status} ${JSON.stringify(injectRes.data || injectRes.error)}${colors.reset}`);
      process.exit(1);
    }
    console.log(`${colors.green}✔ Coupon bug injected:${colors.reset} ${injectRes.data?.message || 'Bug active'}`);

    if (options.simulateTraffic) {
      console.log(`${colors.bold}[2/3] Simulating coupon application traffic to trip TypeError & forward telemetry...${colors.reset}`);
      const cartId = `chaos_sev2_probe_${Date.now()}`;
      await apiRequest(`${options.quickcartUrl}/api/cart/items`, 'POST', { cart_id: cartId, product_id: 1, quantity: 1 });

      const couponRes = await apiRequest(`${options.quickcartUrl}/api/cart/apply-coupon`, 'POST', {
        cart_id: cartId,
        coupon_code: 'SUMMER50'
      });

      if (couponRes.status === 500) {
        console.log(`${colors.green}✔ Coupon application threw TypeError as expected:${colors.reset} HTTP 500 ERR_COUPON_CALCULATION`);
        console.log(`${colors.green}✔ QuickCart Telemetry Forwarder intercepted error and forwarded signal with stack trace to Appsolve!${colors.reset}`);
      } else {
        console.log(`${colors.yellow}ℹ Coupon endpoint returned status ${couponRes.status}:${colors.reset}`, couponRes.data);
      }
    }

    console.log(`${colors.bold}[3/3] Checking Appsolve AI SRE incident generation...${colors.reset}`);
    console.log(`  Appsolve triages signal as SEV-2, generates unified git diff, and opens GitHub Pull Request.`);

    console.log(`\n${colors.bold}${colors.green}================================================================${colors.reset}`);
    console.log(`${colors.bold}${colors.green}  ✔ SEV-2 INCIDENT INJECTED & ACTIVE${colors.reset}`);
    console.log(`${colors.bold}  Severity:       ${colors.yellow}SEV-2 (HIGH SEVERITY)${colors.reset}`);
    console.log(`${colors.bold}  Error Code:     ${colors.white}ERR_COUPON_CALCULATION${colors.reset}`);
    console.log(`${colors.bold}  Guardrail Mode: ${colors.yellow}approval_required${colors.reset}`);
    console.log(`${colors.bold}  Remediation:    ${colors.cyan}Appsolve War Room -> Review PR Unified Diff & Approve Merge + Hot-Sync${colors.reset}`);
    console.log(`${colors.bold}  To Reset:       ${colors.cyan}bin/chaos reset${colors.reset}`);
    console.log(`${colors.bold}${colors.green}================================================================${colors.reset}\n`);

  } else if (normalized === 'sev3') {
    // ----------------------------------------------------
    // SEV-3: Catalog Cache Bloat Simulation
    // ----------------------------------------------------
    console.log(`${colors.bold}[1/3] Injecting ${options.count} bloated cache entries into CatalogService cache...${colors.reset}`);
    const injectRes = await apiRequest(`${options.quickcartUrl}/api/chaos/bloat-cache`, 'POST', {
      count: options.count,
      forward_telemetry: false
    });
    if (!injectRes.ok) {
      console.error(`${colors.red}✖ Failed to bloat cache: ${injectRes.status} ${JSON.stringify(injectRes.data || injectRes.error)}${colors.reset}`);
      process.exit(1);
    }
    console.log(`${colors.green}✔ Cache bloated successfully:${colors.reset} ${injectRes.data?.message || 'Bloat active'}`);

    console.log(`${colors.bold}[2/3] Inspecting cache metrics via SRE Bridge...${colors.reset}`);
    const inspectRes = await execBridgeCommand(options.quickcartUrl, options.token, 'inspect_cache');
    if (inspectRes.ok) {
      console.log(`  Bridge Diagnostic: ${colors.yellow}${inspectRes.data?.output || 'Critical pressure'}${colors.reset}`);
    }

    console.log(`${colors.bold}[3/3] Emitting raw cache bloat telemetry signal to Appsolve for TypeSafe Jev AI categorization...${colors.reset}`);
    const telemetryRes = await apiRequest(`${options.appsolveUrl}/api/v1/telemetry/signals`, 'POST', {
      service_slug: 'catalog',
      error_code: 'ERR_CACHE_BLOAT',
      message: `Image and thumbnail catalog cache bloat exceeded watermark: ${options.count} entries (memory pressure 94%)`,
      raw_payload: {
        bloat_count: options.count,
        memory_mb: 480,
        source_file: 'src/services/catalog.service.ts',
        line_number: 157
      }
    });

    if (telemetryRes.ok) {
      console.log(`${colors.green}✔ Appsolve ingested SEV-3 signal:${colors.reset} Autonomy Mode: ${colors.green}${telemetryRes.data?.incident?.autonomy_mode || 'full_autonomy'}${colors.reset}`);
    } else {
      console.log(`${colors.yellow}ℹ Note: Appsolve ingestion endpoint returned ${telemetryRes.status} (Appsolve may be offline or in mock mode).${colors.reset}`);
    }

    console.log(`\n${colors.bold}${colors.green}================================================================${colors.reset}`);
    console.log(`${colors.bold}${colors.green}  ✔ SEV-3 INCIDENT INJECTED & AUTONOMOUS PURGE TRIGGERED${colors.reset}`);
    console.log(`${colors.bold}  Severity:       ${colors.blue}SEV-3 (MINOR / INFRASTRUCTURE)${colors.reset}`);
    console.log(`${colors.bold}  Error Code:     ${colors.white}ERR_CACHE_BLOAT${colors.reset}`);
    console.log(`${colors.bold}  Guardrail Mode: ${colors.green}full_autonomy${colors.reset} (Autonomous resolution without manual approval)`);
    console.log(`${colors.bold}  Remediation:    ${colors.cyan}Bridge autonomously executes 'purge_cache'${colors.reset}`);
    console.log(`${colors.bold}  To Reset:       ${colors.cyan}bin/chaos reset${colors.reset}`);
    console.log(`${colors.bold}${colors.green}================================================================${colors.reset}\n`);

  } else if (normalized === 'tax') {
    // ----------------------------------------------------
    // UNASSIGNED SEV: Tax Calculation Bug Injection
    // ----------------------------------------------------
    console.log(`${colors.bold}[1/3] Injecting tax calculation bug (EU_UNCONFIGURED_TAX_ZONE rate missing)...${colors.reset}`);
    const injectRes = await apiRequest(`${options.quickcartUrl}/api/chaos/inject/tax-bug`, 'POST', {});
    if (!injectRes.ok) {
      console.error(`${colors.red}✖ Failed to inject tax bug: ${injectRes.status} ${JSON.stringify(injectRes.data || injectRes.error)}${colors.reset}`);
      process.exit(1);
    }
    console.log(`${colors.green}✔ Tax calculation bug injected:${colors.reset} ${injectRes.data?.message || 'Bug active'}`);

    if (options.simulateTraffic) {
      console.log(`${colors.bold}[2/3] Simulating cart fetch traffic to trip tax calculation error & forward telemetry...${colors.reset}`);
      const cartId = `chaos_tax_probe_${Date.now()}`;
      await apiRequest(`${options.quickcartUrl}/api/cart/items`, 'POST', { cart_id: cartId, product_id: 1, quantity: 1 });
      const cartRes = await apiRequest(`${options.quickcartUrl}/api/cart?cart_id=${cartId}`, 'GET');

      if (cartRes.status === 500) {
        console.log(`${colors.green}✔ Cart calculation threw TypeError as expected:${colors.reset} HTTP 500 ERR_TAX_CALCULATION`);
        console.log(`${colors.green}✔ QuickCart Telemetry Forwarder emitted signal with SEV UNASSIGNED to Appsolve!${colors.reset}`);
      } else {
        console.log(`${colors.yellow}ℹ Cart endpoint returned status ${cartRes.status}:${colors.reset}`, cartRes.data);
      }
    }

    console.log(`${colors.bold}[3/3] Inspecting triage path...${colors.reset}`);
    console.log(`  Telemetry severity: ${colors.magenta}UNASSIGNED (Dynamic AI Triage)${colors.reset}`);
    console.log(`  TypeSafe Jev analyzes error impact on cart & checkout to classify severity dynamically.`);

    console.log(`\n${colors.bold}${colors.green}================================================================${colors.reset}`);
    console.log(`${colors.bold}${colors.green}  ✔ TAX CALCULATION BUG INJECTED (UNASSIGNED SEV)${colors.reset}`);
    console.log(`${colors.bold}  Severity:       ${colors.magenta}UNASSIGNED (Evaluated by TypeSafe Jev AI)${colors.reset}`);
    console.log(`${colors.bold}  Error Code:     ${colors.white}ERR_TAX_CALCULATION${colors.reset}`);
    console.log(`${colors.bold}  Impact:         ${colors.yellow}Cart and checkout total calculations crash on client${colors.reset}`);
    console.log(`${colors.bold}  To Reset:       ${colors.cyan}bin/chaos reset${colors.reset}`);
    console.log(`${colors.bold}${colors.green}================================================================${colors.reset}\n`);

  } else if (normalized === 'inventory') {
    // ----------------------------------------------------
    // UNASSIGNED SEV: Inventory Sync Bug Injection
    // ----------------------------------------------------
    console.log(`${colors.bold}[1/3] Injecting inventory sync bug (warehouse realtime channel missing)...${colors.reset}`);
    const injectRes = await apiRequest(`${options.quickcartUrl}/api/chaos/inject/inventory-bug`, 'POST', {});
    if (!injectRes.ok) {
      console.error(`${colors.red}✖ Failed to inject inventory bug: ${injectRes.status} ${JSON.stringify(injectRes.data || injectRes.error)}${colors.reset}`);
      process.exit(1);
    }
    console.log(`${colors.green}✔ Inventory sync bug injected:${colors.reset} ${injectRes.data?.message || 'Bug active'}`);

    if (options.simulateTraffic) {
      console.log(`${colors.bold}[2/3] Simulating add-to-cart traffic to trip inventory reservation error & forward telemetry...${colors.reset}`);
      const cartId = `chaos_inventory_probe_${Date.now()}`;
      const addRes = await apiRequest(`${options.quickcartUrl}/api/cart/items`, 'POST', {
        cart_id: cartId,
        product_id: 1,
        quantity: 1
      });

      if (addRes.status === 500) {
        console.log(`${colors.green}✔ Add to cart threw TypeError as expected:${colors.reset} HTTP 500 ERR_INVENTORY_SYNC`);
        console.log(`${colors.green}✔ QuickCart Telemetry Forwarder emitted signal with SEV UNASSIGNED to Appsolve!${colors.reset}`);
      } else {
        console.log(`${colors.yellow}ℹ Add item endpoint returned status ${addRes.status}:${colors.reset}`, addRes.data);
      }
    }

    console.log(`${colors.bold}[3/3] Inspecting triage path...${colors.reset}`);
    console.log(`  Telemetry severity: ${colors.magenta}UNASSIGNED (Dynamic AI Triage)${colors.reset}`);
    console.log(`  TypeSafe Jev analyzes inventory reservation failure on add-to-cart.`);

    console.log(`\n${colors.bold}${colors.green}================================================================${colors.reset}`);
    console.log(`${colors.bold}${colors.green}  ✔ INVENTORY SYNC BUG INJECTED (UNASSIGNED SEV)${colors.reset}`);
    console.log(`${colors.bold}  Severity:       ${colors.magenta}UNASSIGNED (Evaluated by TypeSafe Jev AI)${colors.reset}`);
    console.log(`${colors.bold}  Error Code:     ${colors.white}ERR_INVENTORY_SYNC${colors.reset}`);
    console.log(`${colors.bold}  Impact:         ${colors.yellow}Customers cannot add items to cart (HTTP 500 Modal Pop-up)${colors.reset}`);
    console.log(`${colors.bold}  To Reset:       ${colors.cyan}bin/chaos reset${colors.reset}`);
    console.log(`${colors.bold}${colors.green}================================================================${colors.reset}\n`);
  }
}

// COMMAND: RESET
async function handleReset(options) {
  console.log(`\n${colors.bold}${colors.magenta}=== APPSOLVE & QUICKCART CHAOS RESET ===${colors.reset}`);
  console.log(`Resetting all chaos fault injections on ${colors.cyan}${options.quickcartUrl}${colors.reset}...\n`);

  // 1. Post to QuickCart /api/chaos/reset
  console.log(`${colors.bold}[1/3] Calling QuickCart /api/chaos/reset...${colors.reset}`);
  const chaosRes = await apiRequest(`${options.quickcartUrl}/api/chaos/reset`, 'POST', {});
  if (chaosRes.ok) {
    console.log(`${colors.green}✔ Chaos state flags cleared.${colors.reset}`);
  } else {
    console.log(`${colors.yellow}⚠ /api/chaos/reset returned ${chaosRes.status}: ${JSON.stringify(chaosRes.data || chaosRes.error)}${colors.reset}`);
  }

  // 2. Kill DB locks via Bridge
  console.log(`${colors.bold}[2/3] Releasing hanging locks via Bridge kill_db_locks...${colors.reset}`);
  const killRes = await execBridgeCommand(options.quickcartUrl, options.token, 'kill_db_locks');
  if (killRes.ok) {
    console.log(`${colors.green}✔ DB Locks released:${colors.reset} ${killRes.data?.output || 'No active locks'}`);
  } else {
    console.log(`${colors.yellow}⚠ SRE Bridge kill_db_locks returned ${killRes.status}${colors.reset}`);
  }

  // 3. Purge catalog cache via Bridge
  console.log(`${colors.bold}[3/3] Purging residual cache bloat via Bridge purge_cache...${colors.reset}`);
  const purgeRes = await execBridgeCommand(options.quickcartUrl, options.token, 'purge_cache');
  if (purgeRes.ok) {
    console.log(`${colors.green}✔ Catalog cache purged:${colors.reset} ${purgeRes.data?.output || 'Cache healthy'}`);
  } else {
    console.log(`${colors.yellow}⚠ SRE Bridge purge_cache returned ${purgeRes.status}${colors.reset}`);
  }

  console.log(`\n${colors.bold}${colors.green}✔ All QuickCart systems restored to healthy baseline operational state.${colors.reset}\n`);
}

// COMMAND: STATUS
async function handleStatus(options) {
  const [healthRes, dbLocksRes, cacheRes, catalogRes, appsolveRes] = await Promise.all([
    apiRequest(`${options.quickcartUrl}/health`),
    execBridgeCommand(options.quickcartUrl, options.token, 'inspect_db_locks'),
    execBridgeCommand(options.quickcartUrl, options.token, 'inspect_cache'),
    apiRequest(`${options.quickcartUrl}/api/v1/catalog/products?limit=1`),
    apiRequest(`${options.appsolveUrl}/api/v1/services`)
  ]);

  if (options.json) {
    console.log(JSON.stringify({
      quickcart: {
        online: healthRes.ok,
        health: healthRes.data,
        locks: dbLocksRes.data?.data,
        cache: cacheRes.data?.data,
        catalogLatencyMs: catalogRes.durationMs
      },
      appsolve: {
        online: appsolveRes.ok,
        services: appsolveRes.data
      }
    }, null, 2));
    return;
  }

  console.log(`\n${colors.bold}${colors.cyan}================================================================${colors.reset}`);
  console.log(`${colors.bold}${colors.cyan}   QUICKCART & APPSOLVE SYSTEM STATUS DASHBOARD${colors.reset}`);
  console.log(`${colors.bold}${colors.cyan}================================================================${colors.reset}\n`);

  console.log(`${colors.bold}1. QuickCart E-Commerce Subsystem (${options.quickcartUrl}):${colors.reset}`);
  console.log(`   Service Reachability:  ${healthRes.ok ? colors.green + '✔ ONLINE (HTTP 200)' : colors.red + '✖ OFFLINE'}${colors.reset}`);
  
  // Database locks status
  const lockData = dbLocksRes.data?.data;
  const isLocked = lockData?.active_locks > 0 || lockData?.status === 'BLOCKED';
  const lockBadge = isLocked
    ? `${colors.bgRed}${colors.white} BLOCKED (SEV-1 DEADLOCK) ${colors.reset} PID: ${lockData?.blocking_pid || 4821} on table '${lockData?.table || 'payment_records'}'`
    : `${colors.green}✔ HEALTHY (No active blocking transactions)${colors.reset}`;
  console.log(`   Checkout DB Locks:     ${lockBadge}`);

  // Catalog cache status
  const cacheData = cacheRes.data?.data;
  const isBloated = cacheData?.bloat_detected || (cacheData?.total_keys || 0) > 5000;
  const cacheBadge = isBloated
    ? `${colors.bgYellow}${colors.bold} CRITICAL PRESSURE (SEV-3 BLOAT) ${colors.reset} ${cacheData?.total_keys || 0} entries (${cacheData?.memory_pressure || '94%'})`
    : `${colors.green}✔ NORMAL (${cacheData?.total_keys || 0} entries, latency ${catalogRes.durationMs}ms)${colors.reset}`;
  console.log(`   Catalog Cache Memory:  ${cacheBadge}`);

  // Appsolve Status
  console.log(`\n${colors.bold}2. Appsolve SRE Platform (${options.appsolveUrl}):${colors.reset}`);
  console.log(`   Platform Reachability: ${appsolveRes.ok ? colors.green + '✔ ONLINE (HTTP 200)' : colors.yellow + 'ℹ OFFLINE / MOCK'}${colors.reset}`);

  if (appsolveRes.ok && appsolveRes.data) {
    const sysStatus = appsolveRes.data.system_status || 'all_operational';
    const activeInc = appsolveRes.data.active_incident;
    console.log(`   System Health State:   ${sysStatus === 'all_operational' ? colors.green + 'ALL SYSTEMS OPERATIONAL' : colors.red + sysStatus.toUpperCase()}${colors.reset}`);
    if (activeInc) {
      console.log(`   Active Incident:       ${colors.red}${activeInc.severity?.toUpperCase()}${colors.reset} - ${activeInc.title} [Status: ${activeInc.status}]`);
    } else {
      console.log(`   Active Incident:       ${colors.green}None (Clean operational queue)${colors.reset}`);
    }

    const aiStatusRes = await apiRequest(`${options.appsolveUrl}/api/v1/system/ai_status`);
    if (aiStatusRes.ok) {
      const aiConn = aiStatusRes.data?.ai_connected;
      const aiBadge = aiConn
        ? `${colors.green}✔ CONNECTED (Autonomous Triage Active)${colors.reset}`
        : `${colors.yellow}○ DISCONNECTED (Token Saving Mode Active)${colors.reset}`;
      console.log(`   AI Automation Engine:  ${aiBadge}`);
    }
  }

  console.log(`\n${colors.bold}${colors.cyan}================================================================${colors.reset}\n`);
}

// COMMAND: VERIFY
async function handleVerify(options) {
  console.log(`\n${colors.bold}${colors.cyan}================================================================${colors.reset}`);
  console.log(`${colors.bold}${colors.cyan}   QUICKCART & APPSOLVE ACCEPTANCE VERIFICATION${colors.reset}`);
  console.log(`${colors.bold}${colors.cyan}================================================================${colors.reset}\n`);

  let totalPassed = 0;
  let totalFailed = 0;

  async function check(name, fn) {
    process.stdout.write(`  Checking ${name.padEnd(46)} `);
    const start = Date.now();
    try {
      const res = await fn();
      const duration = Date.now() - start;
      if (res === true || (res && res.ok)) {
        console.log(`${colors.green}✔ PASS${colors.reset} ${colors.dim}(${duration}ms)${colors.reset}`);
        totalPassed++;
      } else {
        const msg = res && res.msg ? res.msg : 'failed';
        console.log(`${colors.red}✖ FAIL${colors.reset} ${colors.dim}(${msg})${colors.reset}`);
        totalFailed++;
      }
    } catch (err) {
      console.log(`${colors.red}✖ ERROR${colors.reset} ${colors.dim}(${err.message})${colors.reset}`);
      totalFailed++;
    }
  }

  // 1. Backend Health Check
  await check('QuickCart Backend Service Health', async () => {
    const res = await apiRequest(`${options.quickcartUrl}/health`);
    return res.status === 200 && res.data?.status === 'ok';
  });

  // 2. Catalog Products Query
  await check('Catalog API & Cache Lookup (<500ms)', async () => {
    const res = await apiRequest(`${options.quickcartUrl}/api/v1/catalog/products`);
    return res.status === 200 && Array.isArray(res.data?.products) && res.durationMs < 500;
  });

  // 3. Cart Item Addition
  const testCartId = `verify_cart_${Date.now()}`;
  await check('Cart Creation & Item Addition', async () => {
    const res = await apiRequest(`${options.quickcartUrl}/api/cart/items`, 'POST', {
      cart_id: testCartId,
      product_id: 1,
      quantity: 1
    });
    return res.status === 200 && res.data?.items?.length > 0;
  });

  // 4. Coupon Calculation
  await check('Cart Coupon Discount Calculation', async () => {
    const res = await apiRequest(`${options.quickcartUrl}/api/cart/apply-coupon`, 'POST', {
      cart_id: testCartId,
      coupon_code: 'SAVE20'
    });
    return res.status === 200 && res.data?.discount > 0;
  });

  // 5. Checkout Transaction & DB Row Locking
  await check('Checkout Transaction Execution', async () => {
    const res = await apiRequest(`${options.quickcartUrl}/api/checkout`, 'POST', {
      cart_id: testCartId,
      shipping_address: '77 Verification Lane, Suite 200',
      payment_method: 'card'
    });
    return res.status === 200 && Boolean(res.data?.order_uuid) && res.data?.status === 'paid';
  });

  // 6. Remote SRE Sandbox Bridge Health
  await check('Remote SRE Bridge Authentication & Exec', async () => {
    const res = await execBridgeCommand(options.quickcartUrl, options.token, 'health_check');
    return res.status === 200 && res.data?.status === 'success';
  });

  // 7. Appsolve Status API (or fallback if offline)
  await check('Appsolve Public Status Service API', async () => {
    const res = await apiRequest(`${options.appsolveUrl}/api/v1/services`);
    return res.status === 200 || res.status === 0; // Soft pass if running in isolated QuickCart mode
  });

  console.log(`\n${colors.bold}${colors.cyan}----------------------------------------------------------------${colors.reset}`);
  console.log(`  Passed: ${colors.green}${totalPassed}${colors.reset} | Failed: ${totalFailed > 0 ? colors.red : colors.green}${totalFailed}${colors.reset}`);
  console.log(`${colors.bold}${colors.cyan}================================================================${colors.reset}\n`);

  if (totalFailed > 0) {
    console.error(`${colors.red}❌ Verification failed: ${totalFailed} check(s) did not meet acceptance criteria.${colors.reset}\n`);
    process.exit(1);
  } else {
    console.log(`${colors.green}🎉 ALL ACCEPTANCE CHECKS PASSED SUCCESSFULLY!${colors.reset}\n`);
    process.exit(0);
  }
}

// COMMAND: AI STATUS & TOGGLE
async function handleAiStatus(options) {
  const res = await apiRequest(`${options.appsolveUrl}/api/v1/system/ai_status`);
  if (!res.ok) {
    console.error(`${colors.red}Failed to reach Appsolve AI status endpoint at ${options.appsolveUrl}${colors.reset}`);
    process.exit(1);
  }
  const connected = res.data?.ai_connected;
  console.log(`\n${colors.bold}Appsolve AI Automation Status:${colors.reset}`);
  console.log(`  State:        ${connected ? colors.green + '✔ CONNECTED (Autonomous Triage Active)' : colors.yellow + '○ DISCONNECTED (Token Saving Mode Active)'}${colors.reset}`);
  console.log(`  Mode:         ${res.data?.mode}`);
  console.log(`  Token Saving: ${res.data?.token_saving_active ? colors.yellow + 'YES (0 tokens consumed during fault testing)' : colors.green + 'NO (Full AI evaluation)'}${colors.reset}\n`);
}

async function handleAiDisconnect(options) {
  const res = await apiRequest(`${options.appsolveUrl}/api/v1/system/ai_disconnect`, 'POST');
  if (!res.ok) {
    console.error(`${colors.red}Failed to disconnect AI automation: ${JSON.stringify(res.error)}${colors.reset}`);
    process.exit(1);
  }
  console.log(`\n${colors.bold}${colors.yellow}✔ AI AUTOMATION DISCONNECTED (TOKEN SAVING MODE ACTIVE)${colors.reset}`);
  console.log(`  ${res.data?.message || 'Hata sinyalleri yapay zeka token harcamadan kaydedilecek.'}`);
  console.log(`  Mobil uygulamada ve emülatörde güvenle hata testleri yapabilirsiniz.\n`);
}

async function handleAiConnect(options) {
  const res = await apiRequest(`${options.appsolveUrl}/api/v1/system/ai_connect`, 'POST');
  if (!res.ok) {
    console.error(`${colors.red}Failed to connect AI automation: ${JSON.stringify(res.error)}${colors.reset}`);
    process.exit(1);
  }
  console.log(`\n${colors.bold}${colors.green}✔ AI AUTOMATION CONNECTED (AUTONOMOUS TRIAGE ACTIVE)${colors.reset}`);
  console.log(`  ${res.data?.message || 'Gelen telemetri sinyalleri TypeSafe Jev ve Gemini Antigravity tarafından triyaj edilecek.'}\n`);
}

async function main() {
  const options = parseArgs();

  if (options.help || !options.command) {
    printHelp();
    process.exit(0);
  }

  switch (options.command) {
    case 'inject':
      await handleInject(options);
      break;
    case 'reset':
      await handleReset(options);
      break;
    case 'status':
      await handleStatus(options);
      break;
    case 'ai-disconnect':
    case 'disconnect':
      await handleAiDisconnect(options);
      break;
    case 'ai-connect':
    case 'connect':
      await handleAiConnect(options);
      break;
    case 'ai-status':
      await handleAiStatus(options);
      break;
    case 'verify':
      await handleVerify(options);
      break;
    default:
      console.error(`${colors.red}Unknown command: '${options.command}'${colors.reset}`);
      printHelp();
      process.exit(1);
  }
}

main().catch(err => {
  console.error(`${colors.red}Fatal error during chaos CLI execution:${colors.reset}`, err);
  process.exit(1);
});
