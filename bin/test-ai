#!/usr/bin/env bash
# Test script for TypeSafe Jev + Google AI Studio Antigravity Agent
set -e

cd "$(dirname "$0")/../backend"
echo "=================================================================="
echo "  Testing TypeSafe Jev (System One) + Antigravity Agent Live"
echo "=================================================================="

bin/rails runner '
  jev = AiSre::TypesafeJevClient.new
  gemini = AiSre::GeminiClient.new

  puts "\n[1/3] TypeSafe Jev Karar Motoru (jev-latest):"
  cart_svc = Service.find_by(slug: "cart")
  sample_signal = {
    "error_code" => "ERR_COUPON_CALCULATION",
    "message" => "TypeError: Cannot read properties of undefined (reading multiplier)",
    "raw_payload" => {
      "source_file" => "src/services/cart.service.ts",
      "line_number" => 192,
      "stack_trace" => "TypeError: Cannot read properties of undefined (reading multiplier)\n    at CartService.applyCoupon (src/services/cart.service.ts:192:45)"
    }
  }

  decision = jev.categorize_signal(service: cart_svc, raw_payload: sample_signal)
  puts "  ✔ Model:      #{decision[:model]}"
  puts "  ✔ Severity:   #{decision[:severity]}"
  puts "  ✔ Kategori:   #{decision[:category]}"
  puts "  ✔ Strateji:   #{decision[:tool_name]}"
  puts "  ✔ Confidence: #{(decision[:confidence].to_f * 100).round(1)}%"

  puts "\n[2/3] Google AI Studio Antigravity Agent Triage Analizi:"
  triage = gemini.analyze_signal(service: cart_svc, raw_payload: sample_signal, jev_decision: decision)
  puts "  ✔ İş Etkisi:  #{triage[:business_impact_reasoning]}"
  puts "  ✔ Kök Neden:  #{triage[:root_cause_hypothesis]}"

  puts "\n[3/3] Antigravity Agent Dinamik Kod Onarımı & Diff Üretimi:"
  inc = Incident.new(
    incident_code: "#INC-LIVE-TEST",
    service: cart_svc,
    title: "ERR_COUPON_CALCULATION",
    severity: decision[:severity],
    hypothesis: triage[:root_cause_hypothesis],
    raw_payload: sample_signal
  )
  git_provider = AiSre::LocalGitProvider.new
  repair = AiSre::CodeRepairService.call(inc, git_provider: git_provider, gemini_client: gemini)
  puts "  ✔ PR Başlığı: #{repair.pr_title}"
  puts "  ✔ Üretilen Git Unified Diff:\n"
  puts repair.unified_diff
  puts "\n=================================================================="
  puts "  🎉 CANLI TEST BAŞARIYLA TAMAMLANDI!"
  puts "=================================================================="
'
