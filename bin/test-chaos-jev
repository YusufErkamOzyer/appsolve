          source_file: "src/services/checkout.service.ts",
          line_number: 31,
          context: { method: "POST", path: "/api/checkout", blocking_pid: 4821, table: "payment_records" }
        },
        metrics: { error_rate: 0.92, p99_latency_ms: 5400 }
      }
    },
    {
