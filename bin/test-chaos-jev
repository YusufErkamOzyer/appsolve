#!/usr/bin/env bash
# ==============================================================================
# TypeSafe Jev (System One) Chaos Severity & Categorization Inference Evaluation
# ONLY TypeSafe Jev API is called. Gemini API calls are strictly forbidden / blocked.
# ==============================================================================
set -e

cd "$(dirname "$0")/../backend"

bin/rails runner '
  require "json"

  # 1. HARD GUARDRAIL: Block any and all calls to Google Gemini API
  if defined?(AiSre::GeminiClient)
    AiSre::GeminiClient.class_eval do
      def analyze_signal(*)
        raise "[SECURITY VIOLATION] Gemini API was invoked during Jev-only evaluation test!"
      end
      def call_gemini_api(*)
        raise "[SECURITY VIOLATION] Gemini API was invoked during Jev-only evaluation test!"
      end
    end
  end

  # Intercept HTTP to count exact endpoints called and enforce Gemini ban
  jev_calls_count = 0
  gemini_calls_count = 0

  original_request = Net::HTTP.instance_method(:request)
  Net::HTTP.define_method(:request) do |req, *args, &block|
    host = self.address.to_s
    if host.include?("googleapis.com") || host.include?("gemini")
      gemini_calls_count += 1
      raise "[GUARDRAIL ERROR] Gemini API call blocked: #{host}#{req.path}"
    elsif host.include?("typesafe.ai")
      jev_calls_count += 1
    end
    original_request.bind(self).call(req, *args, &block)
  end

  client = AiSre::TypesafeJevClient.new
  unless client.configured?
    puts "\e[31m[ERROR] TypeSafe Jev API is not configured or TYPESAFE_API_KEY is missing!\e[0m"
    exit 1
  end

  puts "\e[1;36m"
  puts "================================================================================="
  puts "   TYPESAFE JEV (SYSTEM ONE) - CHAOS SEV INFERENCE & ACCURACY BENCHMARK"
  puts "   Mod: SADECE TypeSafe Jev API | Gemini API: KESİNLİKLE KAPALI (0 Çağrı)"
  puts "   Hedef Model: #{ENV.fetch("TYPESAFE_MODEL", "jev-latest")} | Endpoint: api.typesafe.ai"
  puts "================================================================================="
  puts "\e[0m"

  services = {
    "checkout" => Service.find_by(slug: "checkout") || Service.new(slug: "checkout", name: "Checkout Service", description: "Payment and checkout transactions"),
    "cart"     => Service.find_by(slug: "cart") || Service.new(slug: "cart", name: "Shopping Cart Service", description: "Cart operations and coupon calculations"),
    "catalog"  => Service.find_by(slug: "catalog") || Service.new(slug: "catalog", name: "Product Catalog Service", description: "Product catalog and cached items"),
    "auth"     => Service.find_by(slug: "auth") || Service.new(slug: "auth", name: "Auth & Identity Service", description: "User session authentication and token validation")
  }

  scenarios = [
    # -------------------------------------------------------------------------
    # GRUP 1: SEV-1 CHAOS (Kritik Kesinti - Checkout & DB Kilitlenmeleri)
    # -------------------------------------------------------------------------
    {
