      expected_category: "database_deadlock",
      expected_tool: "kill_db_locks_and_failover",
      payload: {
        error_code: "ERR_DB_DEADLOCK",
        message: "Database transaction deadlock detected: table payment_records locked waiting on PID 4821",
        raw_payload: {
          stack_trace: "DeadlockError: transaction deadlock detected on payment_records\n    at acquirePaymentRowLock (/quickcart/backend/src/db/locks.ts:38:11)\n    at Object.lockCheckout (/quickcart/backend/src/db/locks.ts:74:5)",
          source_file: "quickcart/backend/src/db/locks.ts",
          line_number: 38,
          context: { blocking_pid: 4821, table: "payment_records" }
        },
        metrics: { error_rate: 1.0, active_locks: 1 }
      }
    },
    {
      id: "CHAOS-SEV1-03",
