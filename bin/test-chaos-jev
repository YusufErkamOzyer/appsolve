      }
    },

    # -------------------------------------------------------------------------
    # GRUP 2: SEV-2 CHAOS (Kısmi Özellik Hatası - Çalışma Zamanı Kod Hataları)
    # -------------------------------------------------------------------------
    {
      id: "CHAOS-SEV2-01",
      group: "SEV-2 (Kod Hatası)",
      name: "QuickCart Kupon Hatası: TypeError: Cannot read properties of undefined (multiplier)",
      service_slug: "cart",
      expected_sev: "SEV-2",
      expected_category: "application_code_bug",
      expected_tool: "rollback_feature_flag",
      payload: {
        error_code: "ERR_COUPON_CALCULATION",
        message: "TypeError: Cannot read properties of undefined (reading '\''multiplier'\'')",
        raw_payload: {
          stack_trace: "TypeError: Cannot read properties of undefined (reading '\''multiplier'\'')\n    at CartService.applyCoupon (/quickcart/backend/src/services/cart.service.ts:192:45)\n    at /quickcart/backend/src/routes/cart.ts:54:19",
          source_file: "src/services/cart.service.ts",
          line_number: 192,
          context: { method: "POST", path: "/api/cart/apply-coupon", coupon_code: "SUMMER50" }
        },
        metrics: { error_rate: 0.28, coupon_failure_rate: 1.0 }
      }
    },
    {
      id: "CHAOS-SEV2-02",
      group: "SEV-2 (Kod Hatası)",
      name: "Kupon indirim hesaplamasında NaN matematik hesaplama hatası",
      service_slug: "cart",
      expected_sev: "SEV-2",
      expected_category: "application_code_bug",
      expected_tool: "rollback_feature_flag",
      payload: {
        error_code: "ERR_COUPON_CALCULATION",
        message: "CalculationError: discount_amount evaluated to NaN on promotional tiered rate multiplier",
        raw_payload: {
          stack_trace: "Error: NaN math calculation on discount_amount = (100 * rateConfig.multiplier) / 100\n    at CartService.applyCoupon (/quickcart/backend/src/services/cart.service.ts:212:35)",
          source_file: "src/services/cart.service.ts",
          line_number: 212,
          context: { coupon_code: "VIP2026", calculated_value: "NaN" }
        },
        metrics: { error_rate: 0.22 }
      }
    },
    {
      id: "CHAOS-SEV2-03",
      group: "SEV-2 (Kod Hatası)",
      name: "ReferenceError: promoConfig.tieredRates[coupon.tier] tanımsız",
      service_slug: "cart",
      expected_sev: "SEV-2",
      expected_category: "application_code_bug",
